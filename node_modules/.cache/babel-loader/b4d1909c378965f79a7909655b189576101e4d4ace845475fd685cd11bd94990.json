{"ast":null,"code":"/* eslint-disable */\nimport axios from 'axios';\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      email: '',\n      password: ''\n    };\n  },\n  methods: {\n    async handleLogin() {\n      try {\n        const response = await axios.post('https://personal-finances-backend.onrender.com/login/login_val/', {\n          user_email: this.email,\n          user_password: this.password\n        });\n        // Handle successful login, e.g., save token, redirect, etc.\n        console.log(response.data);\n      } catch (error) {\n        // Handle error\n        console.error(error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","email","password","methods","handleLogin","response","post","user_email","user_password","console","log","error"],"sources":["/home/waldemar936/FrontPFT/frontend-pft/src/components/Login.vue"],"sourcesContent":["<template>\n    <div class=\"login-container\">\n      <div class=\"login-form\">\n        <img src=\"@/assets/pft_logo.png\" alt=\"Logo\" class=\"logo\" />\n        <h4>Personal Finances Tracking</h4>\n        <form @submit.prevent=\"handleLogin\">\n          <div class=\"input-group\">\n            <label for=\"email\">Email</label>\n            <input type=\"email\" v-model=\"email\" required />\n          </div>\n          <div class=\"input-group\">\n            <label for=\"password\">Password</label>\n            <input type=\"password\" v-model=\"password\" required />\n          </div>\n          <div class=\"input-group\">\n            <button type=\"submit\">Login</button>\n          </div>\n          <div class=\"input-group\">\n            <button type=\"submit\">Create an Account</button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  /* eslint-disable */\n  import axios from 'axios';\n  \n  export default {\n    name: 'Login',\n    data() {\n      return {\n        email: '',\n        password: ''\n      };\n    },\n    methods: {\n      async handleLogin() {\n        try {\n          const response = await axios.post('https://personal-finances-backend.onrender.com/login/login_val/', {\n            user_email: this.email,\n            user_password: this.password\n          });\n          // Handle successful login, e.g., save token, redirect, etc.\n          console.log(response.data);\n        } catch (error) {\n          // Handle error\n          console.error(error);\n        }\n      }\n    }\n  };\n  </script>\n  \n  <style scoped>\n  .login-container {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    height: 100vh;\n  }\n  .logo {\n    width: 100px;\n    margin-bottom: 1em;\n    align-self: center;\n  }\n  .login-form {\n    padding: 2em;\n    border-radius: 8px;\n    box-shadow: 0 2px 10px rgb(28, 221, 235);\n    width: 300px;\n  }\n  .login-form h2 {\n    margin-bottom: 1em;\n    text-align: center;\n  }\n  .input-group {\n    margin-bottom: 1em;\n  }\n  .input-group label {\n    display: block;\n    margin-bottom: 0.5em;\n  }\n  .input-group input {\n    width: 95%;\n    padding: 0.5em;\n    border: 1px solid rgb(28, 221, 235);\n    border-radius: 4px;\n  }\n  .input-group button {\n    width: 100%;\n    padding: 0.5em;\n    border: 1px solid rgb(28, 221, 235);\n    border-radius: 4px;\n  }\n  button {\n    width: 100%;\n    padding: 0.5em;\n    border: none;\n    border-radius: 4px;\n    background-color: rgb(28, 221, 235);\n    color: white;\n    font-size: 1em;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n  }\n  button:hover {\n    background-color: #95ff3e;\n    color: black;\n  }\n  </style>\n  "],"mappings":"AA0BE;AACA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,OAAO;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,WAAWA,CAAA,EAAG;MAClB,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMP,KAAK,CAACQ,IAAI,CAAC,iEAAiE,EAAE;UACnGC,UAAU,EAAE,IAAI,CAACN,