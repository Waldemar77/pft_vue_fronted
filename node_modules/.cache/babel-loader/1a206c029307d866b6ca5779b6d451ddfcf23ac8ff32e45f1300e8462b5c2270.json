{"ast":null,"code":"export default {\n  name: 'BudgetView',\n  data() {\n    return {\n      years: [2025, 2026, 2027, 2028, 2029, 2030],\n      months: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],\n      selectedYear: new Date().getFullYear(),\n      selectedMonth: new Date().toLocaleString('default', {\n        month: 'long'\n      }),\n      expandedPanel: null,\n      showIncomeForm: false,\n      showExpenseForm: false,\n      incomeCategories: ['Salary', 'Investment', 'Other'],\n      expenseCategories: ['Food', 'Transport', 'Rent', 'Other'],\n      newIncome: {\n        category: '',\n        value: '',\n        description: ''\n      },\n      newExpense: {\n        category: '',\n        value: '',\n        description: ''\n      }\n    };\n  },\n  methods: {\n    togglePanel(panel) {\n      this.expandedPanel = this.expandedPanel === panel ? null : panel;\n    },\n    saveIncome() {\n      // Logic to save the income budget\n      console.log('Saving income:', this.newIncome);\n      this.resetForm('income');\n      this.showIncomeForm = false;\n    },\n    saveExpense() {\n      // Logic to save the expense budget\n      console.log('Saving expense:', this.newExpense);\n      this.resetForm('expense');\n      this.showExpenseForm = false;\n    },\n    resetForm(type) {\n      if (type === 'income') {\n        this.newIncome = {\n          category: '',\n          value: '',\n          description: ''\n        };\n      } else {\n        this.newExpense = {\n          category: '',\n          value: '',\n          description: ''\n        };\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","years","months","selectedYear","Date","getFullYear","selectedMonth","toLocaleString","month","expandedPanel","showIncomeForm","showExpenseForm","incomeCategories","expenseCategories","newIncome","category","value","description","newExpense","methods","togglePanel","panel","saveIncome","console","log","resetForm","saveExpense","type"],"sources":["/home/waldemar936/FrontPFT/frontend-pft/src/components/BudgetCreate.vue"],"sourcesContent":["<template>\n    <div class=\"budget-view\">\n      <!-- Combobox for Year and Month -->\n      <div class=\"selectors\">\n        <select v-model=\"selectedYear\">\n          <option v-for=\"year in years\" :key=\"year\" :value=\"year\">{{ year }}</option>\n        </select>\n        <select v-model=\"selectedMonth\">\n          <option v-for=\"month in months\" :key=\"month\" :value=\"month\">{{ month }}</option>\n        </select>\n      </div>\n  \n      <!-- Expansion Panels -->\n      <div class=\"expansion-panel\">\n        <div @click=\"togglePanel('incomes')\" class=\"panel-header\">Incomes</div>\n        <div v-if=\"expandedPanel === 'incomes'\" class=\"panel-content\">\n          <button @click=\"showIncomeForm = !showIncomeForm\">Add New Income</button>\n          <div v-if=\"showIncomeForm\" class=\"form\">\n            <select v-model=\"newIncome.category\">\n              <option v-for=\"category in incomeCategories\" :key=\"category\" :value=\"category\">{{ category }}</option>\n            </select>\n            <input type=\"text\" v-model=\"newIncome.value\" placeholder=\"Value\" />\n            <input type=\"text\" v-model=\"newIncome.description\" placeholder=\"Description\" />\n            <button @click=\"saveIncome\">Save</button>\n          </div>\n        </div>\n      </div>\n  \n      <div class=\"expansion-panel\">\n        <div @click=\"togglePanel('expenses')\" class=\"panel-header\">Expenses</div>\n        <div v-if=\"expandedPanel === 'expenses'\" class=\"panel-content\">\n          <button @click=\"showExpenseForm = !showExpenseForm\">Add New Expense</button>\n          <div v-if=\"showExpenseForm\" class=\"form\">\n            <select v-model=\"newExpense.category\">\n              <option v-for=\"category in expenseCategories\" :key=\"category\" :value=\"category\">{{ category }}</option>\n            </select>\n            <input type=\"text\" v-model=\"newExpense.value\" placeholder=\"Value\" />\n            <input type=\"text\" v-model=\"newExpense.description\" placeholder=\"Description\" />\n            <button @click=\"saveExpense\">Save</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  export default {\n    name: 'BudgetView',\n    data() {\n      return {\n        years: [2025, 2026, 2027, 2028, 2029, 2030],\n        months: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],\n        selectedYear: new Date().getFullYear(),\n        selectedMonth: new Date().toLocaleString('default', { month: 'long' }),\n        expandedPanel: null,\n        showIncomeForm: false,\n        showExpenseForm: false,\n        incomeCategories: ['Salary', 'Investment', 'Other'],\n        expenseCategories: ['Food', 'Transport', 'Rent', 'Other'],\n        newIncome: {\n          category: '',\n          value: '',\n          description: ''\n        },\n        newExpense: {\n          category: '',\n          value: '',\n          description: ''\n        }\n      };\n    },\n    methods: {\n      togglePanel(panel) {\n        this.expandedPanel = this.expandedPanel === panel ? null : panel;\n      },\n      saveIncome() {\n        // Logic to save the income budget\n        console.log('Saving income:', this.newIncome);\n        this.resetForm('income');\n        this.showIncomeForm = false;\n      },\n      saveExpense() {\n        // Logic to save the expense budget\n        console.log('Saving expense:', this.newExpense);\n        this.resetForm('expense');\n        this.showExpenseForm = false;\n      },\n      resetForm(type) {\n        if (type === 'income') {\n          this.newIncome = { category: '', value: '', description: '' };\n        } else {\n          this.newExpense = { category: '', value: '', description: '' };\n        }\n      }\n    }\n  };\n  </script>\n  \n  <style scoped>\n  .budget-view {\n    padding: 20px;\n  }\n  \n  .selectors {\n    display: flex;\n    gap: 10px;\n    margin-bottom: 20px;\n  }\n  \n  .selectors select {\n    padding: 5px;\n    font-size: 16px;\n  }\n  \n  .expansion-panel {\n    margin-bottom: 20px;\n    border: 1px solid #ddd;\n    border-radius: 5px;\n    overflow: hidden;\n  }\n  \n  .panel-header {\n    padding: 10px;\n    color: black;\n    background-color: rgb(16, 131, 139);\n    cursor: pointer;\n  }\n  \n  .panel-content {\n    padding: 10px;\n    background-color: rgb(25, 103, 105);;\n  }\n  \n  .form {\n    margin-top: 10px;\n  }\n  \n  .form select,\n  .form input {\n    display: block;\n    width: 100%;\n    margin-bottom: 10px;\n    padding: 5px;\n    font-size: 16px;\n  }\n  \n  .form button {\n    padding: 5px 10px;\n    background-color: #4caf50;\n    color: #030303;\n    border: none;\n    cursor: pointer;\n  }\n  </style>\n  "],"mappings":"AA8CE,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,CAAC,IAAI,EAAE,IAAI,EAAE,IAAI,EAAE,IAAI,EAAE,IAAI,EAAE,IAAI,CAAC;MAC3CC,MAAM,EAAE,CAAC,SAAS,EAAE,UAAU,EAAE,OAAO,EAAE,OAAO,EAAE,KAAK,EAAE,MAAM,EAAE,MAAM,EAAE,QAAQ,EAAE,WAAW,EAAE,SAAS,EAAE,UAAU,EAAE,UAAU,CAAC;MAClIC,YAAY,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC;MACtCC,aAAa,EAAE,IAAIF,IAAI,CAAC,CAAC,CAACG,cAAc,CAAC,SAAS,EAAE;QAAEC,KAAK,EAAE;MAAO,CAAC,CAAC;MACtEC,aAAa,EAAE,IAAI;MACnBC,cAAc,EAAE,KAAK;MACrBC,eAAe,EAAE,KAAK;MACtBC,gBAAgB,EAAE,CAAC,QAAQ,EAAE,YAAY,EAAE,OAAO,CAAC;MACnDC,iBAAiB,EAAE,CAAC,MAAM,EAAE,WAAW,EAAE,MAAM,EAAE,OAAO,CAAC;MACzDC,SAAS,EAAE;QACTC,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE,EAAE;QACTC,WAAW,EAAE;MACf,CAAC;MACDC,UAAU,EAAE;QACVH,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE,EAAE;QACTC,WAAW,EAAE;MACf;IACF,CAAC;EACH,CAAC;EACDE,OAAO,EAAE;IACPC,WAAWA,CAACC,KAAK,EAAE;MACjB,IAAI,CAACZ,aAAY,GAAI,IAAI,CAACA,aAAY,KAAMY,KAAI,GAAI,IAAG,GAAIA,KAAK;IAClE,CAAC;IACDC,UAAUA,CAAA,EAAG;MACX;MACAC,OAAO,CAACC,GAAG,CAAC