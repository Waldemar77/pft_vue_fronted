{"ast":null,"code":"export default {\n  name: 'BottomNavigation',\n  data() {\n    return {\n      items: [{\n        name: 'Recents',\n        icon: 'fa fa-history'\n      }, {\n        name: 'Favorites',\n        icon: 'fa fa-heart'\n      }, {\n        name: 'Nearby',\n        icon: 'fa fa-map-marker'\n      }],\n      activeItem: 'Nearby'\n    };\n  },\n  methods: {\n    selectItem(item) {\n      this.activeItem = item.name;\n      this.$emit('update', item.name);\n    }\n  }\n};","map":{"version":3,"names":["name","data","items","icon","activeItem","methods","selectItem","item","$emit"],"sources":["/home/waldemar936/FrontPFT/frontend-pft/src/components/HomeView.vue"],"sourcesContent":["<template>\n    <div class=\"bottom-nav\">\n      <div \n        v-for=\"item in items\" \n        :key=\"item.name\" \n        :class=\"['nav-item', { active: item.name === activeItem }]\" \n        @click=\"selectItem(item)\"\n      >\n        <i :class=\"item.icon\"></i>\n        <span>{{ item.name }}</span>\n      </div>\n    </div>\n  </template>\n  \n  <script>\n  export default {\n    name: 'BottomNavigation',\n    data() {\n      return {\n        items: [\n          { name: 'Recents', icon: 'fa fa-history' },\n          { name: 'Favorites', icon: 'fa fa-heart' },\n          { name: 'Nearby', icon: 'fa fa-map-marker' }\n        ],\n        activeItem: 'Nearby'\n      };\n    },\n    methods: {\n      selectItem(item) {\n        this.activeItem = item.name;\n        this.$emit('update', item.name);\n      }\n    }\n  };\n  </script>\n  \n  <style scoped>\n  .bottom-nav {\n    display: flex;\n    justify-content: space-around;\n    background-color: rgb(3, 24, 26);\n    border-top: 1px solid #ddd;\n    padding: 10px 0;\n    position: fixed;\n    bottom: 0;\n    width: 100%;\n    box-shadow: 0 -1px 5px rgba(0, 0, 0, 0.1);\n  }\n  \n  .nav-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    flex: 1;\n    text-align: center;\n    padding: 10px 0;\n    cursor: pointer;\n  }\n  \n  .nav-item i {\n    display: block;\n    font-size: 20px;\n  }\n  \n  .nav-item span {\n    display: block;\n    margin-top: 5px;\n    font-size: 12px;\n  }\n  \n  .nav-item.active {\n    background-color: #e0f7fa;\n    border-radius: 5px;\n  }\n  </style>\n  "],"mappings":"AAeE,eAAe;EACbA,IAAI,EAAE,kBAAkB;EACxBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,CACL;QAAEF,IAAI,EAAE,SAAS;QAAEG,IAAI,EAAE;MAAgB,CAAC,EAC1C;QAAEH,IAAI,EAAE,WAAW;QAAEG,IAAI,EAAE;MAAc,CAAC,EAC1C;QAAEH,IAAI,EAAE,QAAQ;QAAEG,IAAI,EAAE;MAAmB,EAC5C;MACDC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAACC,IAAI,EAAE;MACf,IAAI,CAACH,UAAS,GAAIG,IAAI,CAACP,IAAI;MAC3B,IAAI,CAACQ,KAAK,CAAC,QAAQ,EAAED,IAAI,CAACP,IAAI,CAAC;IACjC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}